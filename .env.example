PORT=3000
SESSION_SECRET=change-me-to-a-random-string
DB_PATH=./data/app.db
NODE_ENV=development
STORAGE_DIR=./data
# Typically just "python" / "tesseract" once both are on PATH (e.g. after
# apt install on the Pi). Only needs a full path where they aren't on PATH.
PYTHON_PATH=python
TESSERACT_PATH=tesseract
# Optional: PlanSwift jobs root for New Project -> Import from PlanSwift.
# UNC path to the share, e.g. \\10.0.30.22\Public\PLANSWIFT\Jobs1
# (or //10.0.30.22/Public/PLANSWIFT/Jobs1). The service account running the
# server needs read access to it. Admins can also set/override the folder
# from the import page, so this can be left empty.
PLANSWIFT_JOBS_DIR=
